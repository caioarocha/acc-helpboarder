# Copie este arquivo para ".env" e preencha. Sem PAT o app roda em modo demonstração.

# Nome da organização (o que vem depois de https://dev.azure.com/)
AZDO_ORG=
# Nome do projeto
AZDO_PROJECT=
# Personal Access Token com escopo "Work Items: Read"
AZDO_PAT=

# (Opcional) Limita o Dashboard a uma Area Path, ex.: Projeto\Time QA
AZDO_AREA_PATH=

# Tipos de Work Item usados na hierarquia US -> Suite -> Test Case
AZDO_TYPE_STORY=User Story
AZDO_TYPE_SUITE=Test Suite IPC
AZDO_TYPE_TEST=Test Case
AZDO_TYPE_BUG=Bug

# (Opcional) Reference name do campo "Execution Mode". Vazio = descobre automaticamente pelo nome.
AZDO_FIELD_EXECUTION_MODE=

# States de Bug considerados fechados (separados por vírgula)
AZDO_BUG_CLOSED_STATES=Closed,Done,Resolved,Removed,Rejected,Cancelled

# Aba Automação: ID da query salva com os cenários automatizados
# (abra a query no Azure DevOps e copie o GUID da URL: .../_queries/query/<ID>/)
AZDO_AUTOMATION_QUERY_ID=
# Tags usadas na aba Automação (opcional, estes são os padrões)
# AZDO_TAG_CONSTRUIDO=Construído
# AZDO_TAG_EM_CONSTRUCAO=Em construção
# AZDO_TAG_CORBAN=CORBAN
# AZDO_TAG_AGENCIAS=Agencias

# Aba Bugs: agente local via Ollama (nada sai da sua máquina).
# Só é aceito endereço local (localhost). Para criar bugs, o PAT precisa de "Work Items: Read & Write".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Porta do backend
API_PORT=3001
