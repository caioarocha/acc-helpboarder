# Copie este arquivo para ".env" e preencha. Sem PAT o app roda em modo demonstração.

# Nome da organização (o que vem depois de https://dev.azure.com/)
AZDO_ORG=
# Nome do projeto
AZDO_PROJECT=
# Personal Access Token com escopo "Work Items: Read"
AZDO_PAT=

# (Opcional) Limita o Dashboard a uma Area Path, ex.: Projeto\Time QA
AZDO_AREA_PATH=

# Tipos de Work Item usados na hierarquia US -> Suite -> Test Case
AZDO_TYPE_STORY=User Story
AZDO_TYPE_SUITE=Test Suite IPC
AZDO_TYPE_TEST=Test Case
AZDO_TYPE_BUG=Bug

# (Opcional) Reference name do campo "Execution Mode". Vazio = descobre automaticamente pelo nome.
AZDO_FIELD_EXECUTION_MODE=

# States de Bug considerados fechados (separados por vírgula)
AZDO_BUG_CLOSED_STATES=Closed,Done,Resolved,Removed,Rejected,Cancelled

# Porta do backend
API_PORT=3001
